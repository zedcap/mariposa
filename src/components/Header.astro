---
/* Site header — marigold.global nav pattern.

   Placement: the header is NOT fixed to the top. It sits in normal
   document flow and uses `position: sticky; top: 0`. On a page with a
   hero it renders directly below the hero, so on load the nav rests
   below the hero imagery. As the user scrolls past the hero the header
   reaches the top of the viewport and sticks there for the rest of the
   scroll. (marigold.global achieves this with a GSAP ScrollTrigger pin;
   native CSS `sticky` gives the same behaviour with no JavaScript.)

   Two visual states:
   - RESTING — below the hero, in flow. Solid white bar, gold
     hairline underneath, no shadow. It belongs to the page.
   - STUCK — detached at the top, content scrolling beneath it. Same
     white bar, plus a faint lift shadow so it reads as a floating
     header, not part of the page body. No backdrop blur: the bar is
     opaque (Stephane, 2026-05-23 — translucency explicitly rejected
     for this surface).

   Cream-tracking RETIRED 2026-05-24 (Stephane). The nav previously
   sampled the section directly beneath its bottom edge and
   interpolated from opaque white to opaque cream as the
   white→cream gradient wedge (`.range__bleed` in ProductSlider)
   slid past. That mechanism — the rAF scroll listener, the
   `--nav-white` / `--nav-cream` token pair, the `--nav-bg-current`
   inline-style channel, and the parseRGB / apply / compute helpers
   — is gone. The bar is now plain white at all times. Sibling
   components still carry their `data-cream-bg` attributes; those
   are dead markers now but harmless, left in place to avoid a
   no-op edit across the page tree.

   `overHero` is true when the page has a hero (the header has somewhere
   to rest below). When false — interior pages with no hero — the header
   is the first element in flow and is therefore stuck from the first
   paint: it renders in the stuck state immediately.

   A 1px sentinel just above the header drives the resting/stuck class
   toggle (a sticky element cannot reliably self-detect its stuck state
   in pure CSS). Without JS the header still sticks correctly; it simply
   keeps its initial styling rather than animating between the two
   states. */
import { withBase } from '../lib/path';

interface Props {
  /** True when the page has a hero for the nav to rest below. */
  overHero?: boolean;
  /* True on the Stories section (the /stories/ index and the
     /stories/<slug> posts). Adds the unlisted "Stories" nav item and
     switches the nav to a burger at mobile widths, because the extra
     item overflows the existing four-item bar there. The four public
     pages (home, /volage, /caprice, /about) never pass this, so their
     nav renders exactly as before: Volage / Caprice / About, no burger. */
  inStories?: boolean;
}
const { overHero = false, inStories = false } = Astro.props;
/* Astro.url.pathname includes the base ('/mariposa/volage' on staging),
   so compare against base-prefixed hrefs. Normalise the trailing slash
   the GitHub Pages build adds to directory URLs. */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '') || '/';
  return target === withBase('/').replace(/\/$/, '')
    ? path === target
    : path.startsWith(target);
};
---

{/* Sentinel — sits in flow right before the header. While it is in
    view the header is resting; once it scrolls out the header is
    stuck. Only rendered when there is a hero to rest below. */}
{overHero && <div class="site-header__sentinel" aria-hidden="true"></div>}

<header
  class:list={['site-header', { 'is-stuck': !overHero, 'site-header--stories': inStories }]}
  data-header
  data-over-hero={overHero ? 'true' : 'false'}
>
  <div class="site-header__inner container">
    <a class="site-header__mark wordmark" href={withBase('/')} aria-label="Mariposa, home">
      mariposa
    </a>

    {/* Burger toggle — only rendered on the Stories section. Hidden on
        desktop via CSS; it controls the nav panel at mobile widths. The
        panel id is referenced by aria-controls; a tiny inline script
        mirrors the open state onto aria-expanded. With JS off the
        :has() fallback below still opens the panel on click. */}
    {inStories && (
      <button
        class="site-header__burger"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Menu"
        data-burger
      >
        <span class="site-header__burger-bars" aria-hidden="true"></span>
      </button>
    )}

    <nav
      id="site-nav"
      class:list={['site-header__nav', { 'site-header__nav--collapsible': inStories }]}
      aria-label="Primary"
      data-nav
    >
      <a href={withBase('/volage')} class:list={[{ 'is-active': isActive('/volage') }]}>Volage</a>
      <a href={withBase('/caprice')} class:list={[{ 'is-active': isActive('/caprice') }]}>Caprice</a>
      {inStories && (
        <a href={withBase('/stories')} class:list={[{ 'is-active': isActive('/stories') }]}>Stories</a>
      )}
      <a href={withBase('/about')} class:list={[{ 'is-active': isActive('/about') }]}>About</a>
    </nav>
  </div>
</header>

<style>
  /* The sentinel carries no height of its own; it just marks the
     point above the header for the observer. */
  .site-header__sentinel {
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
  }

  .site-header {
    /* The pattern: rests in flow below the hero, sticks at the top
       once it gets there. */
    position: sticky;
    top: 0;
    z-index: 60;
    /* Solid white at all times (Stephane 2026-05-24). Cream-tracking
       retired — see file header comment. */
    background-color: #ffffff;
    border-bottom: 1px solid var(--border-gold);
    /* Shadow eases in on stuck. */
    transition: box-shadow var(--dur-default) var(--ease-paper);
  }

  /* STUCK — detached at the top of the viewport. A faint lift shadow
     gives separation from scrolling content beneath; the bar contracts
     a touch — the Marigold nav, which shortens once the user is past
     the hero. No backdrop-filter: the surface is fully opaque, so the
     blur would do nothing and the brief rejects translucency for this
     surface anyway. */
  .site-header.is-stuck {
    box-shadow: 0 1px 16px rgba(31, 27, 23, 0.08);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 84px;
    /* The bar height eases down when the header sticks. */
    transition: height var(--dur-default) var(--ease-paper);
  }
  .site-header.is-stuck .site-header__inner {
    height: 66px;
  }

  .site-header__mark {
    font-size: 1.25rem;
    color: var(--gold-deep);
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    gap: var(--space-7);
  }

  .site-header__nav a {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 400;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-default) var(--ease-paper),
      border-color var(--dur-default) var(--ease-paper);
  }

  .site-header__nav a:hover {
    color: var(--gold-deep);
  }

  .site-header__nav a.is-active {
    border-bottom-color: var(--gold);
    color: var(--gold-deep);
  }

  /* ── Stories burger ────────────────────────────────────────────
     Only present on the Stories section. The nav there carries one
     extra item (Stories) and overflows the bar at mobile widths, so
     below 720px the nav items collapse behind this burger toggle.
     Hidden on desktop and on every non-Stories page (the button is
     not even rendered there). */
  .site-header__burger {
    display: none; /* desktop + non-Stories: never shown */
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: 0;
    padding: var(--space-3);
    margin: 0;
    cursor: pointer;
    color: var(--ink);
    line-height: 0;
  }
  /* Three-bar glyph drawn with a 1px-edged box + pseudo-elements.
     No icon font, no inline SVG file: a hand-drawn mark. */
  .site-header__burger-bars,
  .site-header__burger-bars::before,
  .site-header__burger-bars::after {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-default) var(--ease-paper),
      opacity var(--dur-default) var(--ease-paper);
  }
  .site-header__burger-bars { position: relative; }
  .site-header__burger-bars::before,
  .site-header__burger-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .site-header__burger-bars::before { top: -6px; }
  .site-header__burger-bars::after { top: 6px; }
  /* Open state — bars cross into an X. */
  .site-header__burger[aria-expanded='true'] .site-header__burger-bars {
    background: transparent;
  }
  .site-header__burger[aria-expanded='true'] .site-header__burger-bars::before {
    transform: translateY(6px) rotate(45deg);
  }
  .site-header__burger[aria-expanded='true'] .site-header__burger-bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 720px) {
    .site-header__inner { height: 66px; }
    .site-header.is-stuck .site-header__inner { height: 56px; }
    .site-header__nav {
      gap: var(--space-4);
      /* Optical alignment: uppercase Hanken nav vs lowercase Spectral
         wordmark. Equal flex-centred boxes leave the caps reading
         higher than the wordmark baseline; a 2px nudge lands them on
         the same visual line. */
      transform: translateY(3px);
    }

    /* Stories section only: show the burger, collapse the nav into a
       dropdown panel beneath the bar. Non-Stories pages keep the inline
       nav above (no .site-header__nav--collapsible, no burger rendered),
       so their mobile nav is unchanged. */
    .site-header--stories .site-header__burger { display: inline-flex; }

    .site-header__nav--collapsible {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-5);
      background: #ffffff;
      border-bottom: 1px solid var(--border-gold);
      box-shadow: 0 8px 16px rgba(31, 27, 23, 0.08);
      padding: var(--space-5) var(--page-pad-m);
      transform: none;
      /* Collapsed by default. */
      display: none;
    }
    /* Open via the burger's aria-expanded (JS path) OR, with JS off,
       the :has() fallback keys off :focus on the button so a tap still
       reveals the panel. */
    .site-header--stories:has(.site-header__burger[aria-expanded='true']) .site-header__nav--collapsible,
    .site-header--stories:has(.site-header__burger:focus) .site-header__nav--collapsible {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__burger-bars,
    .site-header__burger-bars::before,
    .site-header__burger-bars::after { transition: none; }
  }

  /* Reduced motion — the stuck-state settle snaps instantly. The
     states still apply (they are information, not decoration); only
     the animated handoff is suppressed. */
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__inner { transition: none; }
  }
</style>

<script>
  /* Header behaviour — resting/stuck toggle only.

     A sentinel before the header drives an IntersectionObserver that
     flips the `.is-stuck` class (carrying the lift shadow + height
     contract).

     The previous scroll-tied background colour mechanism (rAF
     listener sampling `.range__bleed`, interpolating between
     `--nav-white` and `--nav-cream` on `--nav-bg-current`) was
     retired 2026-05-24 per Stephane. The bar is now plain white at
     all times; see the file header comment for the full account. */
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (header && header.dataset.overHero === 'true') {
    const sentinel = header.previousElementSibling;
    if (sentinel) {
      const io = new IntersectionObserver(
        ([entry]) => header.classList.toggle('is-stuck', !entry.isIntersecting),
        { threshold: 0 },
      );
      io.observe(sentinel);
    }
  }

  /* Stories burger toggle. Only present on the Stories section; absent
     elsewhere, so this is a no-op on the four public pages. Drives
     aria-expanded (the CSS opens the panel off that attribute). The
     no-JS :has(:focus) fallback in the CSS keeps the panel reachable
     if this never runs. Closes on Escape and on outside click. */
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  if (burger && header) {
    const setOpen = (open: boolean) =>
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (
        burger.getAttribute('aria-expanded') === 'true' &&
        !header.contains(e.target as Node)
      ) {
        setOpen(false);
      }
    });
  }
</script>
